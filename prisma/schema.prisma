generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  categoryId  String
  name        String
  brand       String?
  model       String?
  description String?
  slug        String  @unique

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  price     Decimal

  product            Product             @relation(fields: [productId], references: [id])
  attributes         VariantAttribute[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Attribute {
  id       String             @id @default(cuid())
  name     String
  slug     String             @unique
  variants VariantAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VariantAttribute {
  variantId   String
  attributeId String
  value       String

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeId])
  @@index([attributeId])
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, position])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id                   String      @id @default(cuid())
  userId               String?
  status               OrderStatus @default(PENDING)
  reservationExpiresAt DateTime?

  customerName  String
  customerPhone String
  customerEmail String

  shippingStreet         String
  shippingExteriorNumber String
  shippingInteriorNumber String?
  shippingNeighborhood   String
  shippingMunicipality   String
  shippingState          String
  shippingPostalCode     String
  shippingReferences     String?

  wantsInvoice        Boolean @default(false)
  billingBusinessName String?
  billingRfc          String?
  billingRegime       String?
  billingCfdiUse      String?

  billingStreet         String?
  billingExteriorNumber String?
  billingInteriorNumber String?
  billingNeighborhood   String?
  billingMunicipality   String?
  billingState          String?
  billingPostalCode     String?
  billingReferences     String?

  total Decimal

  user     User?       @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String

  productName String
  sku         String
  unitPrice   Decimal
  quantity    Int

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant     @relation(fields: [variantId], references: [id])
  inventoryMovement InventoryMovement?

  createdAt DateTime @default(now())

  @@unique([orderId, variantId])
  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  mercadoPagoId     String   @unique
  status            String
  transactionAmount Decimal?
  paymentType       String?
  rawPayload        Json

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

model InventoryMovement {
  id          String                @id @default(cuid())
  variantId   String
  orderItemId String?
  type        InventoryMovementType
  quantity    Int
  reason      String?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id])

  createdAt DateTime @default(now())

  @@unique([orderItemId])
  @@index([variantId])
  @@index([variantId, createdAt])
}
